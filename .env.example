# חיבור למסד הנתונים (Postgres / Neon)
DATABASE_URL=

# סוד לחתימת טוקני JWT - מחרוזת ארוכה ואקראית, שונה בכל סביבה
JWT_SECRET=

# פורט השרת (אופציונלי, ברירת מחדל 5000; ב-Render זה מוגדר אוטומטית)
PORT=5000

# כתובת הפרונטאנד האמיתית ב-production (Vercel) - אם מוגדר, CORS יוגבל רק
# אליו; אם ריק (כמו בפיתוח מקומי), CORS נשאר פתוח לגמרי
FRONTEND_URL=

# Twilio Verify - שליחת קוד אימות SMS אמיתי. אם שלושת השדות האלה ריקים,
# האפליקציה נופלת אוטומטית למצב סימולציה (קוד מודפס לטרמינל) - שימושי
# לפיתוח מקומי בלי לשלם/לחכות ל-SMS אמיתי. ראו src/config/sms.js
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
