generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. משתמשים (לקוחות ובעלי עסקים)
model User {
  id           String   @id @default(uuid())
  firstName    String?
  lastName     String?
  phone        String   @unique
  isVerified   Boolean  @default(false)
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now())

  appointments     Appointment[]
  businesses       Business[]
  reviews          Review[]
  sentSwapRequests     SwapRequest[]  @relation("SentRequests")
  receivedSwapRequests SwapRequest[]  @relation("OwnerRequests")
}

enum Role {
  CLIENT
  ADMIN
}

// 2. קודי אימות זמניים ל-SMS
model VerificationCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// 3. עסקים (מספרה / קליניקה / מכון)
model Business {
  id          String   @id @default(uuid())
  name        String
  address     String?
  description String?
  logoUrl     String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])

  // 👈 הגדרות טווח שעות דינמי ע"י בעל העסק
  openTime         String        @default("09:00") // שעת פתיחה (HH:mm)
  closeTime        String        @default("19:30") // שעת סגירה (HH:mm)
  slotInterval     Int           @default(30)      // מרווח תורים בדקות (15/20/30/45/60)

  // 👈 פתיחת ופרסום יומן שבועי (YYYY-MM-DD - עד מתי היומן פתוח להזמנות)
  bookingOpenUntil String?

  providers    Provider[]
  services     Service[]
  appointments Appointment[]
  blockedDays  BlockedDay[]
  reviews      Review[]
  broadcasts   Broadcast[]
  createdAt    DateTime      @default(now())
}

// 4. מעניקי השירות / אנשי צוות (ספר, מעצבת)
model Provider {
  id         String   @id @default(uuid())
  name       String
  imageUrl   String?
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  appointments Appointment[]
  blockedDays  BlockedDay[]
}

// 5. שירותים ומחירים
model Service {
  id          String   @id @default(uuid())
  name        String
  price       Float
  durationMin Int      // משך זמן בדקות
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])

  appointments Appointment[]
}

// 6. התורים עצמם
model Appointment {
  id          String            @id @default(uuid())
  dateTime    DateTime
  status      AppointmentStatus @default(PENDING)
  isUpForSwap Boolean           @default(false)

  userId     String
  user       User             @relation(fields: [userId], references: [id])

  businessId String
  business   Business         @relation(fields: [businessId], references: [id])

  providerId String
  provider   Provider         @relation(fields: [providerId], references: [id])

  serviceId  String
  service    Service          @relation(fields: [serviceId], references: [id])

  swapOffer        SwapOffer?
  targetInRequests SwapRequest[] @relation("TargetAppointment")
  ownerInRequests  SwapRequest[] @relation("OwnerAppointment")

  createdAt DateTime @default(now())
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

// 7. שוק החלפות תורים - הצעות פעילות
model SwapOffer {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  
  requests      SwapRequest[]
  createdAt     DateTime    @default(now())
}

// 8. בקשות החלפה בין משתמשים
model SwapRequest {
  id                   String            @id @default(uuid())
  // אופציונלי + SetNull (במקום Cascade): כשה-SwapOffer נמחק בעת אישור ההחלפה
  // הבקשה עצמה חייבת להישאר בחיים כרשומת היסטוריה, לא להימחק יחד איתו
  swapOfferId          String?
  swapOffer            SwapOffer?        @relation(fields: [swapOfferId], references: [id], onDelete: SetNull)

  requesterId          String
  requester            User              @relation("SentRequests", fields: [requesterId], references: [id])

  // בעל ההצעה בזמן יצירת הבקשה - שדה קבוע ובלתי תלוי, כי ה-userId על גבי
  // Appointment עצמו משתנה ברגע שההחלפה מאושרת (התור עובר לבעלים החדש)
  ownerId              String
  owner                User              @relation("OwnerRequests", fields: [ownerId], references: [id])

  offeredAppointmentId String
  offeredAppointment   Appointment       @relation("TargetAppointment", fields: [offeredAppointmentId], references: [id])

  // הפניה ישירה (לא דרך SwapOffer) לתור של בעל ההצעה, כדי שהמידע (שעה/שירות)
  // ישרוד גם אחרי שה-SwapOffer נמחק בעת אישור ההחלפה
  ownerAppointmentId   String
  ownerAppointment     Appointment       @relation("OwnerAppointment", fields: [ownerAppointmentId], references: [id])

  status               SwapRequestStatus @default(PENDING)
  createdAt            DateTime          @default(now())
}

enum SwapRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model BlockedDay {
  id         String   @id @default(uuid())
  date       String   // פורמט YYYY-MM-DD
  reason     String?
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  providerId String?  // אם null = כל העסק סגור, אם יש ID = הספר הספציפי חופש
  provider   Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

//  הודעות מערכת ועדכונים של בעל העסק ללקוחות 👈 (נוסף)
model Broadcast {
  id         String   @id @default(uuid())
  message    String
  isActive   Boolean  @default(true)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

// 9. ביקורות ודירוגים
model Review {
  id         String   @id @default(uuid())
  rating     Int      
  comment    String
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  createdAt  DateTime @default(now())
}